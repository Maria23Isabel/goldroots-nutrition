{
  "name": "goldroots-nutrition",
  "private": true,
  "version": "0.1.0",
  "description": "Vitrina de Gold Roots Nutrition: réplica mejorada de goldrootsvitamins.com. Informativa (sin carrito), con los 14 productos reales, filtros por objetivo y un código QR por producto. React + Vite + Tailwind, sin servidor.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:pages": "vite build --mode pages && node scripts/postbuild.mjs --pages",
    "preview": "vite preview",
    "datos": "node scripts/traer-productos.mjs",
    "datos:herbavida": "node scripts/traer-marcas.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "publicar": "npm run build:pages && node scripts/publicar-pages.mjs",
    "desplegar": "node scripts/desplegar.mjs",
    "desplegar:qa": "node scripts/desplegar.mjs --qa",
    "desplegar:dominio": "node scripts/desplegar.mjs --dominio"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "motion": "^14.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.7",
    "wrangler": "^4.86.0"
  }
}
