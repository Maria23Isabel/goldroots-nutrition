// Gold Roots Nutrition — ambiente de QA: un Worker aparte (goldroots-nutrition-qa) con su propia dirección *.workers.dev,
// para validar cada versión antes de subirla al Worker actual o al dominio. Solo entrega archivos de dist/: sin código de servidor,
// sin base de datos y sin variables secretas. Se publica con `npm run desplegar:qa`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldroots-nutrition-qa",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
